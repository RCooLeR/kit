# The kit builds no image of its own. Consumers pin a commit through the module proxy; a build that
# reads a local checkout as a named context (`--build-context kit=../kit`) while trying a change
# gets repository metadata and local state kept out of what is sent to the builder.
.git
.github
.idea
.vscode
**/.env
**/.env.*
**/*.exe
**/*.test
**/*.out
**/*.log
