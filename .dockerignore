# The kit builds no image of its own, but a consumer's Dockerfile can read this checkout as a named
# build context (`--build-context kit=../kit`) instead of downloading a tagged version. Keep
# repository metadata and local state out of what is sent to the builder.
.git
.github
.idea
.vscode
**/.env
**/.env.*
**/*.exe
**/*.test
**/*.out
**/*.log
